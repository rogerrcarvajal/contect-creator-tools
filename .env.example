# Environment Configuration - ContentCreator-Tools (Zero-Trust Standard)
# Copy this file to .env and configure your local environment variables.
# NEVER commit real API keys or secrets to the repository.

APP_ENV=development
APP_PORT=8080

# AI Provider Keys (Optional - used by 04-extractor-shorts-virales Python CLI)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Whisper & FFmpeg Configuration
WHISPER_MODEL_SIZE=base
FFMPEG_BINARY_PATH=ffmpeg
TARGET_FPS=60
SHORT_DURATION_SECONDS=40
SHORT_RESOLUTION_WIDTH=1080
SHORT_RESOLUTION_HEIGHT=1920
